@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

/* =========================================================
   GLOBAL
========================================================= */

:root {
    --bg: #020617;
    --panel: rgba(15, 23, 42, 0.68);
    --panel-soft: rgba(15, 23, 42, 0.48);
    --border: rgba(51, 65, 85, 0.72);

    --text: #f8fafc;
    --muted: #94a3b8;
    --muted-dark: #64748b;

    --accent: #818cf8;
    --accent-bright: #a5b4fc;
    --accent-dark: #6366f1;

    --radius: 24px;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(79, 70, 229, 0.10),
            transparent 32%
        ),
        radial-gradient(
            circle at 85% 80%,
            rgba(99, 102, 241, 0.08),
            transparent 30%
        ),
        var(--bg);

    overflow: hidden;
    color: var(--text);
}

body.modal-open {
    overflow: hidden;
}


/* =========================================================
   HORIZONTAL SCROLL
========================================================= */

#horizontal-wrapper {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;

    height: calc(100vh - 4rem);

    scrollbar-width: thin;
    scrollbar-color:
        rgba(99, 102, 241, 0.7)
        transparent;
}

.horizontal-slide {
    flex: 0 0 100vw;
    width: 100vw;

    min-height: 100%;
    scroll-snap-align: start;

    overflow-y: auto;
    overflow-x: hidden;
}

#horizontal-wrapper::-webkit-scrollbar {
    height: 6px;
}

#horizontal-wrapper::-webkit-scrollbar-track {
    background: transparent;
}

#horizontal-wrapper::-webkit-scrollbar-thumb {
    background: rgba(99, 102, 241, 0.65);
    border-radius: 999px;
}


/* =========================================================
   GLASS
========================================================= */

.glass {
    background:
        linear-gradient(
            145deg,
            rgba(15, 23, 42, 0.76),
            rgba(15, 23, 42, 0.48)
        );

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    border: 1px solid var(--border);

    box-shadow:
        0 20px 70px rgba(0, 0, 0, 0.18);

    transition:
        border-color 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.glass:hover {
    border-color:
        rgba(129, 140, 248, 0.42);

    box-shadow:
        0 25px 80px rgba(79, 70, 229, 0.10);
}


/* =========================================================
   GRADIENT TEXT
========================================================= */

.gradient-text {
    background:
        linear-gradient(
            100deg,
            #c7d2fe,
            #818cf8,
            #c4b5fd
        );

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
}


/* =========================================================
   SECTION LABEL
========================================================= */

.section-label {
    letter-spacing: 0.18em;
}


/* =========================================================
   HERO PROFILE PHOTO
========================================================= */

.profile-photo-wrapper {
    width: 170px;
    height: 150px;

    border-radius: 32px;

    padding: 4px;

    background:
        linear-gradient(
            145deg,
            rgba(129, 140, 248, 0.8),
            rgba(99, 102, 241, 0.18),
            rgba(196, 181, 253, 0.6)
        );

    box-shadow:
        0 0 45px rgba(99, 102, 241, 0.15);

    flex-shrink: 0;
}

.profile-photo-wrapper img {
    width: 100%;
    height: 100%;

    border-radius: 28px;

    object-fit: cover;
    object-position: center;

    display: block;
}


/* =========================================================
   HERO CARD
========================================================= */

.hero-profile-card {
    position: relative;
    overflow: hidden;
}

.hero-profile-card::before {
    content: "";

    position: absolute;

    width: 250px;
    height: 220px;

    top: -110px;
    right: -90px;

    background:
        radial-gradient(
            circle,
            rgba(99, 102, 241, 0.16),
            transparent 70%
        );

    pointer-events: none;
}


/* =========================================================
   SKILL PILLS
========================================================= */

.skill-pill {
    display: inline-flex;
    align-items: center;

    padding: 0.5rem 0.8rem;

    border-radius: 9999px;

    background:
        rgba(30, 41, 59, 0.65);

    border:
        1px solid rgba(71, 85, 105, 0.7);

    color: #cbd5e1;

    font-size: 10px;
    font-weight: 600;

    transition: all 0.25s ease;
}

.skill-pill:hover {
    color: #e0e7ff;

    border-color:
        rgba(129, 140, 248, 0.5);

    background:
        rgba(79, 70, 229, 0.12);
}


/* =========================================================
   INTEREST CARDS
========================================================= */

.interest-card {
    min-height: 100px;

    padding: 1rem;

    border-radius: 18px;

    background:
        rgba(2, 6, 23, 0.38);

    border:
        1px solid rgba(51, 65, 85, 0.65);

    display: flex;
    flex-direction: column;

    justify-content: center;

    gap: 0.65rem;

    transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        background 0.25s ease;
}

.interest-card:hover {
    transform: translateY(-3px);

    border-color:
        rgba(129, 140, 248, 0.45);

    background:
        rgba(30, 41, 59, 0.48);
}

.interest-card svg {
    width: 18px;
    height: 18px;

    color: #818cf8;
}

.interest-card span {
    color: #cbd5e1;

    font-size: 11px;
    font-weight: 600;
}


/* =========================================================
   EXPERIENCE
========================================================= */

.experience-item {
    display: flex;
    gap: 0.85rem;

    padding: 1rem;

    border-radius: 16px;

    background:
        rgba(2, 6, 23, 0.38);

    border:
        1px solid rgba(51, 65, 85, 0.62);

    transition:
        border-color 0.25s ease,
        transform 0.25s ease;
}

.experience-item:hover {
    transform: translateY(-2px);

    border-color:
        rgba(129, 140, 248, 0.4);
}

.experience-item svg {
    width: 17px;
    height: 17px;

    color: #818cf8;

    flex-shrink: 0;

    margin-top: 2px;
}

.experience-item p {
    color: #94a3b8;

    font-size: 12px;
    line-height: 1.7;
}


/* =========================================================
   TAGS
========================================================= */

.tag {
    display: inline-flex;
    align-items: center;

    padding: 0.42rem 0.7rem;

    border-radius: 9px;

    background:
        rgba(30, 41, 59, 0.72);

    border:
        1px solid rgba(51, 65, 85, 0.72);

    color: #a5b4fc;

    font-size: 10px;
    font-weight: 600;
}


/* =========================================================
   PROJECT CARDS
========================================================= */

.project-card {
    position: relative;

    min-height: 390px;

    padding: 1.5rem;

    border-radius: 24px;

    background:
        linear-gradient(
            145deg,
            rgba(15, 23, 42, 0.82),
            rgba(15, 23, 42, 0.55)
        );

    border:
        1px solid rgba(51, 65, 85, 0.75);

    overflow: hidden;

    transition:
        transform 0.35s ease,
        border-color 0.35s ease,
        box-shadow 0.35s ease;
}

.project-card:hover {
    transform: translateY(-7px);

    border-color:
        rgba(129, 140, 248, 0.55);

    box-shadow:
        0 25px 70px rgba(79, 70, 229, 0.14);
}

.project-glow {
    position: absolute;

    width: 250px;
    height: 250px;

    top: -150px;
    right: -100px;

    background:
        radial-gradient(
            circle,
            rgba(99, 102, 241, 0.16),
            transparent 70%
        );

    opacity: 0;

    transition:
        opacity 0.35s ease;
}

.project-card:hover .project-glow {
    opacity: 1;
}


/* FEATURED ANALYTICS */

.featured-project {
    border-color:
        rgba(99, 102, 241, 0.32);

    background:
        linear-gradient(
            145deg,
            rgba(30, 27, 75, 0.52),
            rgba(15, 23, 42, 0.68)
        );
}

.featured-project::after {
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    pointer-events: none;

    box-shadow:
        inset 0 0 0 1px
        rgba(129, 140, 248, 0.04);
}


/* =========================================================
   PROJECT BADGES
========================================================= */

.live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    padding: 0.4rem 0.65rem;

    border-radius: 9999px;

    background:
        rgba(34, 197, 94, 0.08);

    border:
        1px solid rgba(34, 197, 94, 0.22);

    color: #86efac;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 0.08em;
}

.live-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #4ade80;

    box-shadow:
        0 0 10px rgba(74, 222, 128, 0.8);

    animation:
        pulse-live 1.8s infinite;
}

@keyframes pulse-live {
    0%, 100% {
        opacity: 1;
    }

    50% {
        opacity: 0.4;
    }
}

.project-type-badge {
    display: inline-flex;

    padding: 0.4rem 0.65rem;

    border-radius: 9999px;

    background:
        rgba(99, 102, 241, 0.09);

    border:
        1px solid rgba(99, 102, 241, 0.2);

    color: #a5b4fc;

    font-size: 9px;
    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 0.08em;
}

.project-number {
    color: #475569;

    font-size: 11px;
    font-weight: 700;
}


/* =========================================================
   PROJECT ICON
========================================================= */

.project-icon {
    width: 46px;
    height: 46px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 1rem;

    background:
        rgba(99, 102, 241, 0.09);

    border:
        1px solid rgba(129, 140, 248, 0.17);
}

.project-icon svg {
    width: 21px;
    height: 21px;

    color: #818cf8;
}


/* =========================================================
   PROJECT TYPOGRAPHY
========================================================= */

.project-title {
    color: #f8fafc;

    font-size: 1.08rem;
    line-height: 1.45;

    font-weight: 800;

    letter-spacing: -0.02em;

    transition:
        color 0.25s ease;
}

.project-card:hover .project-title {
    color: #c7d2fe;
}

.project-category {
    margin-top: 0.45rem;

    color: #818cf8;

    font-size: 10px;
    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.07em;
}

.project-summary {
    margin-top: 0.8rem;

    color: #94a3b8;

    font-size: 12px;
    line-height: 1.75;
}


/* =========================================================
   PROJECT TAGS
========================================================= */

.project-tag {
    display: inline-flex;

    padding: 0.38rem 0.58rem;

    border-radius: 8px;

    background:
        rgba(30, 41, 59, 0.68);

    border:
        1px solid rgba(51, 65, 85, 0.72);

    color: #a5b4fc;

    font-size: 9px;
    font-weight: 600;
}


/* =========================================================
   PROJECT FOOTER
========================================================= */

.project-footer {
    margin-top: auto;

    padding-top: 1.25rem;

    border-top:
        1px solid rgba(51, 65, 85, 0.6);
}

.project-button {
    width: 100%;

    display: flex;
    align-items: center;

    gap: 0.6rem;

    padding: 0.75rem 0.9rem;

    border-radius: 12px;

    background:
        rgba(2, 6, 23, 0.55);

    border:
        1px solid rgba(51, 65, 85, 0.75);

    color: #a5b4fc;

    font-size: 11px;
    font-weight: 700;

    transition:
        background 0.25s ease,
        border-color 0.25s ease,
        color 0.25s ease;
}

.project-button:hover {
    background:
        #4f46e5;

    border-color:
        #6366f1;

    color: white;
}


/* =========================================================
   MODAL
========================================================= */

#project-modal {
    animation:
        modal-fade 0.25s ease;
}

@keyframes modal-fade {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

#project-modal > div {
    animation:
        modal-up 0.3s ease;
}

@keyframes modal-up {
    from {
        transform: translateY(15px) scale(0.98);
        opacity: 0;
    }

    to {
        transform: translateY(0) scale(1);
        opacity: 1;
    }
}


/* =========================================================
   MODAL WORK ITEMS
========================================================= */

.modal-work-item {
    display: flex;

    gap: 0.75rem;

    padding: 1rem;

    border-radius: 15px;

    background:
        rgba(2, 6, 23, 0.42);

    border:
        1px solid rgba(51, 65, 85, 0.6);
}

.modal-work-icon {
    width: 30px;
    height: 30px;

    flex-shrink: 0;

    border-radius: 9px;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        rgba(99, 102, 241, 0.1);

    color: #818cf8;
}

.modal-work-label {
    color: #e2e8f0;

    font-size: 11px;
    font-weight: 700;

    margin-bottom: 3px;
}

.modal-work-text {
    color: #94a3b8;

    font-size: 11px;

    line-height: 1.7;
}


/* =========================================================
   MODAL TAGS
========================================================= */

.skill-tag,
.tool-tag {
    display: inline-flex;
    align-items: center;

    padding: 0.45rem 0.7rem;

    border-radius: 9px;

    font-size: 10px;
    font-weight: 600;
}

.skill-tag {
    background:
        rgba(99, 102, 241, 0.1);

    border:
        1px solid rgba(99, 102, 241, 0.2);

    color: #c7d2fe;
}

.tool-tag {
    background:
        rgba(30, 41, 59, 0.75);

    border:
        1px solid rgba(51, 65, 85, 0.72);

    color: #a5b4fc;
}


/* =========================================================
   GALLERY
========================================================= */

.gallery-card {
    overflow: hidden;

    border-radius: 20px;

    background:
        rgba(2, 6, 23, 0.5);

    border:
        1px solid rgba(51, 65, 85, 0.7);
}

.gallery-image-wrapper {
    overflow: hidden;

    background: #020617;
}

.gallery-image {
    width: 200%;

    display: block;

    object-fit: cover;

    transition:
        transform 0.4s ease;
}

.gallery-card:hover .gallery-image {
    transform: scale(1.03);
}

.gallery-caption {
    padding: 0.8rem 1rem;

    color: #cbd5e1;

    font-size: 10px;
    font-weight: 600;
}


/* =========================================================
   CONTACT
========================================================= */

.contact-link {
    display: flex;
    align-items: center;

    gap: 0.9rem;

    padding: 0.9rem 1rem;

    border-radius: 16px;

    background:
        rgba(15, 23, 42, 0.6);

    border:
        1px solid rgba(51, 65, 85, 0.7);

    transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        background 0.25s ease;
}

.contact-link:hover {
    transform: translateY(-2px);

    border-color:
        rgba(129, 140, 248, 0.45);

    background:
        rgba(30, 41, 59, 0.65);
}

.contact-link svg {
    width: 18px;
    height: 18px;

    color: #818cf8;

    flex-shrink: 0;
}


/* =========================================================
   FORM
========================================================= */

.input-label {
    display: block;

    margin-bottom: 0.4rem;

    color: #94a3b8;

    font-size: 10px;
    font-weight: 600;
}

.input-field {
    width: 100%;

    padding: 0.75rem 0.9rem;

    border-radius: 11px;

    background:
        rgba(2, 6, 23, 0.72);

    border:
        1px solid rgba(51, 65, 85, 0.8);

    color: #e2e8f0;

    font-size: 12px;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.input-field::placeholder {
    color: #475569;
}

.input-field:focus {
    border-color: #6366f1;

    box-shadow:
        0 0 0 3px
        rgba(99, 102, 241, 0.08);
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .project-card {
        min-height: 450px;
    }

    .profile-photo-wrapper {
        width: 112px;
        height: 112px;
    }
}


@media (max-width: 640px) {

    #horizontal-wrapper {
        height: calc(100vh - 4rem);
    }

    .project-card {
        min-height: 360px;

        padding: 1.25rem;
    }

    .profile-photo-wrapper {
        width: 100px;
        height: 100px;

        border-radius: 25px;
    }

    .profile-photo-wrapper img {
        border-radius: 21px;
    }
}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}